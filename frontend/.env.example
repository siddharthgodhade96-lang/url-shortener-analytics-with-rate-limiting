# Optional settings. Copy to ".env" only if you need to change them.

# Where short links point to. Must be the address of the BACKEND.
VITE_SHORT_LINK_BASE_URL=http://localhost:8080

# Leave empty in development (Vite forwards /api to the backend).
# Set it only when you serve the built files from another server, for example:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
